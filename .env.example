# =============================================================================
# SSM-Pay Environment Configuration
# =============================================================================
# Copy this file to .env and update with your actual values.
# NEVER commit your .env file to version control!
# =============================================================================

# -----------------------------------------------------------------------------
# Application Settings
# -----------------------------------------------------------------------------
NODE_ENV=development                           # Environment: development, production, test
APP_ENVIRONMENT=production                     # Application environment identifier
APP_NAME=SSM Pay                               # Application name displayed in logs/UI
APP_VERSION=1.0.0                              # Application version string
APP_DESCRIPTION=Enterprise Payment Platform    # Application description for metadata
BASE_URL=http://localhost:9002                 # Base URL for the application (used for callbacks)
PORT=9002                                      # Server port number
HOST=0.0.0.0                                   # Server host binding address

# -----------------------------------------------------------------------------
# Next.js Public Environment Variables (exposed to browser)
# Must be prefixed with NEXT_PUBLIC_ to be available client-side
# -----------------------------------------------------------------------------
NEXT_PUBLIC_ZAINPAY_PUBLIC_KEY=your_zainpay_public_key_here   # ZainPay public key (client-side)
NEXT_PUBLIC_ZAINBOX_CODE_NAME=your_zainbox_code_name_here     # ZainBox code name (client-side)

# -----------------------------------------------------------------------------
# ZainPay API Configuration
# -----------------------------------------------------------------------------
ZAINPAY_PUBLIC_KEY=your_zainpay_public_key_here       # ZainPay API public key
ZAINPAY_SECRET_KEY=your_zainpay_secret_key_here       # ZainPay API secret key (keep secure!)
ZAINPAY_API_BASE_URL=https://api.zainpay.ng           # ZainPay API base URL override
ZAINPAY_BASE_URL=https://api.zainpay.ng               # ZainPay base URL (alias)
ZAINBOX_CODE_NAME=your_zainbox_code_name_here         # Your unique ZainBox code name
ZAINPAY_SANDBOX_MODE=true                             # Enable sandbox/test mode (true/false)
ZAINPAY_TIMEOUT=30000                                 # Request timeout in milliseconds
ZAINPAY_RETRY_ATTEMPTS=3                              # Number of retry attempts on failure
ZAINPAY_RETRY_DELAY=1000                              # Delay between retries in milliseconds

# -----------------------------------------------------------------------------
# Database Configuration (PostgreSQL / SQLite)
# -----------------------------------------------------------------------------
DATABASE_URL=file:./data/ssm-pay.db                  # Database connection URL (PostgreSQL or SQLite)
DB_POOL_SIZE=10                                       # Database connection pool size
DB_CONNECTION_TIMEOUT=30000                           # Connection timeout in milliseconds
DB_QUERY_TIMEOUT=30000                                # Query execution timeout in milliseconds
DB_MIGRATE_ON_START=true                              # Auto-run migrations on startup (true/false)
DB_LOG_QUERIES=false                                  # Log SQL queries (true/false)
SLOW_QUERY_THRESHOLD=1000                             # Slow query threshold in milliseconds

# -----------------------------------------------------------------------------
# Redis Configuration (Optional - for caching/sessions)
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379                      # Redis connection URL
REDIS_HOST=localhost                                   # Redis server host
REDIS_PORT=6379                                       # Redis server port
REDIS_PASSWORD=                                        # Redis authentication password (empty = no auth)
REDIS_CACHE_TTL=3600                                  # Default cache TTL in seconds
REDIS_SESSION_TTL=86400                               # Session storage TTL in seconds
REDIS_RATE_LIMIT_TTL=60                               # Rate limit window TTL in seconds
REDIS_MAX_MEMORY=256mb                                # Maximum memory usage
REDIS_MAX_MEMORY_POLICY=allkeys-lru                   # Memory eviction policy
REDIS_CLUSTER_MODE=false                              # Enable Redis cluster mode

# -----------------------------------------------------------------------------
# API Configuration
# -----------------------------------------------------------------------------
API_PREFIX=/api                                       # API route prefix
API_VERSION=v1                                        # API version identifier
DEFAULT_PAGE_SIZE=20                                  # Default pagination page size
MAX_PAGE_SIZE=100                                     # Maximum allowed page size
REQUEST_TIMEOUT=30000                                 # Default API request timeout (ms)
ENABLE_COMPRESSION=true                               # Enable response compression (true/false)
ENABLE_RATE_LIMITING=true                             # Enable rate limiting (true/false)
ENABLE_REQUEST_LOGGING=false                          # Enable detailed request logging (true/false)

# -----------------------------------------------------------------------------
# CORS Configuration
# -----------------------------------------------------------------------------
CORS_ORIGINS=*                                       # Allowed origins (comma-separated, * = all)
CORS_METHODS=GET,POST,PUT,DELETE,PATCH,OPTIONS        # Allowed HTTP methods
CORS_HEADERS=Content-Type,Authorization,X-Requested-With  # Allowed headers
CORS_CREDENTIALS=false                                # Allow credentials (true/false)
CORS_MAX_AGE=86400                                    # Preflight cache duration (seconds)

# -----------------------------------------------------------------------------
# Server Configuration
# -----------------------------------------------------------------------------
SERVER_START_TIMEOUT=30000                            # Server startup timeout (ms)
SERVER_SHUTDOWN_TIMEOUT=10000                         # Graceful shutdown timeout (ms)
BODY_SIZE_LIMIT=10mb                                  # Max request body size
PAYLOAD_SIZE_LIMIT=10mb                               # Max payload size limit
MAX_REQUEST_BODY_SIZE=10mb                            # Security: max request body size

# -----------------------------------------------------------------------------
# Security & Authentication
# -----------------------------------------------------------------------------
JWT_SECRET=change-me-in-production                    # JWT signing secret (MUST change in prod!)
JWT_EXPIRES_IN=7d                                     # JWT token expiration time
BCRYPT_ROUNDS=12                                      # Password hashing rounds (higher = more secure)
SESSION_SECRET=change-me-in-production                # Session encryption secret
ENCRYPTION_KEY=change-me-32-char-hex-key              # 32-char hex key for data encryption
CSRF_PROTECTION=true                                  # Enable CSRF protection (true/false)
HELMET_ENABLED=true                                   # Enable Helmet.js security headers (true/false)

# -----------------------------------------------------------------------------
# Webhook Configuration
# -----------------------------------------------------------------------------
WEBHOOK_SECRET=whsec_change_me_in_production          # Webhook signing secret for verification
WEBHOOK_TOLERANCE_SECONDS=300                         # Webhook timestamp tolerance (seconds)
WEBHOOK_MAX_RETRIES=5                                 # Maximum webhook delivery retries
WEBHOOK_RETRY_DELAY_MS=1000                           # Base delay between retries (ms)
WEBHOOK_VERIFY_PAYLOAD=true                           # Verify webhook payload integrity (true/false)
CALLBACK_BASE_URL=http://localhost:9002               # Base URL for payment callbacks

# -----------------------------------------------------------------------------
# Rate Limiting Configuration
# -----------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000                            # Rate limit time window (ms)
RATE_LIMIT_MAX_REQUESTS=100                           # Max requests per window
RATE_LIMIT_SKIP_HEALTH_CHECK=true                     # Skip rate limiting for health endpoints
RATE_LIMIT_SKIP_API_KEY=true                          # Skip rate limiting for API key auth
RATE_LIMIT_IP_WHITELIST=                              # Comma-separated IPs to whitelist

# -----------------------------------------------------------------------------
# Caching Configuration (In-Memory)
# -----------------------------------------------------------------------------
CACHE_DEFAULT_TTL_MS=300000                           # Default cache TTL (5 minutes)
CACHE_MAX_SIZE_BYTES=52428800                         # Max cache size (50MB)
CACHE_MAX_ENTRIES=10000                               # Max cached entries
CACHE_CLEANUP_INTERVAL_MS=60000                       # Cleanup interval (1 minute)
CACHE_COMPRESSION=false                               # Enable cache compression (true/false)
CACHE_COMPRESSION_THRESHOLD=1024                      # Min size for compression (bytes)

# -----------------------------------------------------------------------------
# Logging Configuration
# -----------------------------------------------------------------------------
LOG_LEVEL=info                                        # Log level: trace, debug, info, warn, error, fatal
LOG_FORMAT=json                                       # Log format: json, text, pretty
LOG_TO_CONSOLE=true                                   # Output logs to console (true/false)
LOG_TO_FILE=false                                     # Enable file logging (true/false)
LOG_DIR=./logs                                        # Directory for log files
LOG_FILENAME=app.log                                  # Log filename
LOG_MAX_SIZE=20mb                                     # Max log file size before rotation
LOG_MAX_FILES=14                                      # Number of rotated log files to keep
LOG_DATE_PATTERN=YYYY-MM-DD                           # Date pattern for log filenames
ENABLE_STRUCTURED_LOGGING=false                       # Enable structured JSON logging (true/false)

# -----------------------------------------------------------------------------
# Monitoring & Observability
# -----------------------------------------------------------------------------
# Sentry Error Tracking
SENTRY_DSN=                                           # Sentry DSN for error tracking
SENTRY_TRACES_SAMPLE_RATE=0.1                         # Performance tracing sample rate (0-1)
SENTRY_PROFILES_SAMPLE_RATE=0.1                       # Profiling sample rate (0-1)
SENTRY_ENABLED=false                                  # Enable Sentry integration (true/false)

# Datadog Monitoring
DATADOG_API_KEY=                                      # Datadog API key
DATADOG_SITE=ssm-pay                                  # Datadog site identifier
DATADOG_SERVICE=ssm-pay-api                           # Service name in Datadog
DATADOG_ENABLED=false                                 # Enable Datadog integration (true/false)

# -----------------------------------------------------------------------------
# Email Notifications (SMTP)
# -----------------------------------------------------------------------------
EMAIL_NOTIFICATIONS_ENABLED=false                     # Enable email notifications (true/false)
EMAIL_FROM_ADDRESS=noreply@ssm-pay.com                # Sender email address
EMAIL_FROM_NAME=SSM Pay                               # Sender display name
SMTP_HOST=smtp.gmail.com                              # SMTP server hostname
SMTP_PORT=587                                         # SMTP server port
SMTP_USER=                                            # SMTP username
SMTP_PASS=                                            # SMTP password
EMAIL_QUEUE_ENABLED=false                             # Enable email queue processing (true/false)
EMAIL_QUEUE_CONCURRENCY=5                             # Email sending concurrency
EMAIL_TEMPLATES_PATH=./templates/email                # Path to email templates

# -----------------------------------------------------------------------------
# SMS Notifications
# -----------------------------------------------------------------------------
SMS_NOTIFICATIONS_ENABLED=false                       # Enable SMS notifications (true/false)
SMS_PROVIDER=termii                                   # SMS provider: twilio, termii, custom
SMS_API_KEY=                                          # SMS provider API key
SMS_SENDER_ID=SSMPay                                 # Sender ID for SMS messages
SMS_QUEUE_ENABLED=false                               # Enable SMS queue processing (true/false)
SMS_QUEUE_CONCURRENCY=3                               # SMS sending concurrency

# -----------------------------------------------------------------------------
# Push Notifications
# -----------------------------------------------------------------------------
PUSH_NOTIFICATIONS_ENABLED=false                      # Enable push notifications (true/false)
FCM_SERVER_KEY=                                       # Firebase Cloud Messaging server key
APNS_KEY_ID=                                          # Apple Push Notification key ID
APNS_TEAM_ID=                                         # Apple developer team ID
APNS_KEY=                                             # Apple Push Notification private key
APNS_ENVIRONMENT=production                           # APNS environment: development, production
IOS_BUNDLE_ID=com.ssm.pay.app                        # iOS bundle identifier
PUSH_TOPIC=all                                        # Default push notification topic

# -----------------------------------------------------------------------------
# In-App Notifications
# -----------------------------------------------------------------------------
IN_APP_NOTIF_TTL_MS=5000                              # In-app notification display duration
IN_APP_MAX_NOTIFICATIONS=50                           # Max stored in-app notifications
IN_APP_SOUND_ENABLED=true                             # Enable notification sound (true/false)
IN_APP_VIBRATION_ENABLED=true                         # Enable vibration on notification (true/false)

# -----------------------------------------------------------------------------
# Feature Flags & Toggles
# -----------------------------------------------------------------------------
ENABLE_ML_FRAUD_DETECTION=false                       # Enable ML-based fraud detection
ENABLE_ADVANCED_ANALYTICS=false                       # Enable advanced analytics features
ENABLE_REALTIME_DASHBOARD=false                       # Enable real-time dashboard updates
ENABLE_BATCH_PROCESSING=false                         # Enable batch job processing
ENABLE_WEBHOOK_RETRY=true                             # Enable automatic webhook retries
ENABLE_MULTI_CURRENCY=false                           # Enable multi-currency support
ENABLE_CUSTOMER_PORTAL=false                          # Enable customer self-service portal
ENABLE_API_DOCS=true                                  # Enable API documentation endpoint
ENABLE_RATELIMIT_DASHBOARD=false                      # Enable rate limit monitoring dashboard
ENABLE_EXCEL_EXPORT=false                             # Enable Excel export functionality
ENABLE_PDF_REPORTS=false                              # Enable PDF report generation
DARK_MODE_DEFAULT=false                               # Default UI theme (dark mode)
MAINTENANCE_MODE=false                                # Enable maintenance mode (show maintenance page)
ENABLE_BETA_FEATURES=false                            # Enable beta/experimental features

# -----------------------------------------------------------------------------
# SSL/TLS Configuration
# -----------------------------------------------------------------------------
SSL_REJECT_UNAUTHORIZED=true                          # Reject unauthorized SSL certificates
SSL_REQUIRE_CERT=false                                # Require client certificates
SSL_MIN_VERSION=TLSv1_2                               # Minimum TLS version required

# -----------------------------------------------------------------------------
# Trusted Proxies & Security Origins
# -----------------------------------------------------------------------------
ALLOWED_ORIGINS=*                                     # Allowed origins for security (comma-separated)
TRUSTED_PROXIES=                                      # Trusted proxy IP addresses (comma-separated)
