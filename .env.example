# Zainpay API Credentials
ZAINPAY_PUBLIC_KEY=your_zainpay_public_key_here
ZAINBOX_CODE_NAME=your_zainbox_code_name_here

# Next.js Public Environment Variables (exposed to browser)
NEXT_PUBLIC_ZAINPAY_PUBLIC_KEY=your_zainpay_public_key_here
NEXT_PUBLIC_ZAINBOX_CODE_NAME=your_zainbox_code_name_here

# Application Base URL
BASE_URL=http://localhost:9002
